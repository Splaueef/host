[Unit]
Description=Hikka Hub authenticated coordination API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hikkahub
Group=hikkahub
WorkingDirectory=/opt/hikka-hub
EnvironmentFile=-/etc/hikka-hub.env
Environment=HIKKA_HUB_BIND=0.0.0.0
Environment=HIKKA_HUB_PORT=8765
Environment=HIKKA_HUB_DATABASE=/var/lib/hikka-hub/hikka-hub.sqlite3
ExecStart=/opt/hikka-hub/.venv/bin/python -m hikka_hub
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/hikka-hub

[Install]
WantedBy=multi-user.target

